# Preferred when the Dev Dashboard client_credentials app returns 400 application_cannot_be_found:
SHOPIFY_ACCESS_TOKEN=shpat_xxx
SHOPIFY_STORE_URL=weatherman3.myshopify.com
# Aliases if SHOPIFY_STORE_URL unset: SHOPIFY_STORE_DOMAIN, SHOPIFY_SHOP_NAME
# Optional OAuth path (only used when SHOPIFY_ACCESS_TOKEN is unset):
# SHOPIFY_CLIENT_ID=your_client_id
# SHOPIFY_CLIENT_SECRET=your_client_secret
WALMART_CLIENT_ID=xxx
WALMART_CLIENT_SECRET=xxx
SELLERBOARD_DAILY_URL=https://app.sellerboard.com/en/automation/reports/?id=xxx&token=xxx
SELLERBOARD_PRODUCT_URL=https://app.sellerboard.com/en/automation/reports/?id=yyy&token=yyy
# Optional: force Sellerboard numeric dates as DMY (default) or MDY (us/0/false)
# SELLERBOARD_DAYFIRST=true
BREVO_API_KEY=xkeysib-xxx
REPORT_RECIPIENTS=marco@weatherman.com, rick@weatherman.com, christine@weatherman.com, margo@ltv-approach.com, sajjad@weatherman.com, mollie@weatherman.com, slease@saxadvisorygroup.com
BREVO_SENDER_EMAIL=marco@weatherman.com
BREVO_SENDER_NAME=Weatherman Revenue
REPORT_GREETING_NAME=Rick
SHOPIFY_AD_SPEND=1712.27
# Optional dated feeds (Date + Spend columns, or {"YYYY-MM-DD": amount})
# SHOPIFY_ADS_CSV_URL=
# SHOPIFY_ADS_CSV_PATH=data/shopify_ad_spend.csv
# SHOPIFY_ADS_JSON_PATH=data/shopify_ad_spend.json
# Pages site root — optional; auto-detected from GITHUB_REPOSITORY in Actions
# mg22mex → https://mg22mex.github.io/Daily-revenue-by-sales-platform  (brand MARCO)
# WeathermanInc → https://weathermaninc.github.io/Daily-revenue-by-sales-platform  (brand WEATHERMAN)
# DASHBOARD_PUBLIC_URL=https://mg22mex.github.io/Daily-revenue-by-sales-platform
# DASHBOARD_BRAND=MARCO
# Optional — Nordstrom channel uses same Shopify+Mirakl set as Nordstrom Summary digest
# MIRAKL_API_KEY=
# MIRAKL_SHOP_ID=7548
# MIRAKL_BASE_URL=https://nordstromus-prod.mirakl.net
# Optional override (same as --date YYYY-MM-DD)
# REPORT_DATE=2026-09-10
